# Copy to .env.local (used by `npm run dev`/`npm run build`) and fill in.

# Required: Google AI Studio / Gemini API key used by every AI feature.
# Create one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional: override the Gemini models and TTS voice.
# VOCALNOTE_TEXT_MODEL=gemini-flash-latest
# VOCALNOTE_TTS_MODEL=gemini-3.8-flash-tts
# VOCALNOTE_TTS_VOICE=Algenib

# Optional: public URL of the deployment, used for absolute Open Graph URLs.
# NEXT_PUBLIC_SITE_URL=https://your-app.example.com
